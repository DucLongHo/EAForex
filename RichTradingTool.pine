//@version=6
indicator("Rich Trading Tool", overlay=true,
          max_bars_back=5000, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════

grp1 = "① Opening Price (OP)"
showOP    = input.bool(true,           "Show OP",         group=grp1)
colOP     = input.color(color.white,   "Line Color",      group=grp1)
colOPUp   = input.color(color.green,   "Bias Up Color",   group=grp1)
colOPDown = input.color(color.red,     "Bias Down Color", group=grp1)

grp2 = "② MLP – Previous Session Midpoint"
showMLP = input.bool(true,          "Show MLP", group=grp2)
colMLP  = input.color(color.yellow, "Color",    group=grp2)

grp3  = "③ Volume Profile — Lookback"
vp_use_visible_range = input.bool(false, "Use Visible Range",             group=grp3)
vp_lookback_depth    = input.int(200,    "Fixed Range Lookback [10-3000]",
                                 minval=10, maxval=3000,                   group=grp3)

grp3a = "③ Volume Profile — Volume Bars"
vp_num_bars      = input.int(200,  "Number of Bars [10-490]",  minval=10, maxval=490, group=grp3a)
vp_bar_thickness = input.int(1,    "Bar Thickness [1-30]",     minval=1,  maxval=30,  group=grp3a)
vp_bar_len_mult  = input.int(20,   "Length Multiplier [1-50]", minval=1,  maxval=50,  group=grp3a)
vp_right_offset  = input.int(70,   "Right Offset [0-400]",     minval=0,  maxval=400, group=grp3a)
vp_volume_type   = input.string("Both", "Volume Type", options=["Both","Bullish","Bearish"], group=grp3a)
vp_bar_color     = input.color(color.new(color.gray, 50), "Bar Color",    group=grp3a)

grp3b = "③ Volume Profile — Point of Control"
vp_display_poc        = input.bool(true,       "Display PoC",                          group=grp3b)
vp_poc_line_thickness = input.int(1,           "PoC Thickness [1-30]", minval=1, maxval=30, group=grp3b)
vp_poc_line_color     = input.color(color.red, "PoC Color",                             group=grp3b)

grp3c = "③ Volume Profile — Value Area"
vp_display_va         = input.bool(true,        "Display Value Area",                   group=grp3c)
vp_va_percent         = input.int(68,           "Value Area % [5-95]", minval=5, maxval=95, group=grp3c)
vp_va_bar_color       = input.color(color.blue, "VA Bar Color",                         group=grp3c)
vp_display_va_lines   = input.bool(true,        "Display VA Lines",                     group=grp3c)
vp_va_lines_thickness = input.int(1,            "VA Lines Thickness [1-20]", minval=1, maxval=20, group=grp3c)

grp4  = "④ KCX – VWAP Bands"
showVWAP     = input.bool(true,  "Show VWAP",          group=grp4)
showBcol     = input.bool(true,  "Bar Colors",         group=grp4)
showPrevVWAP = input.bool(false, "Show Previous VWAP", group=grp4)
vwapLblSize  = input.string("Tiny", "Band Label Size",
               options=["Tiny","Small","Normal","Large","Huge"],  group=grp4)

grp4a = "④ KCX – Band Multipliers"
devUp1  = input.float(1.28, "±1 Above", step=0.01, group=grp4a)
devDn1  = input.float(1.28, "±1 Below", step=0.01, group=grp4a)
devUp2  = input.float(2.01, "±2 Above", step=0.01, group=grp4a)
devDn2  = input.float(2.01, "±2 Below", step=0.01, group=grp4a)
showDv2 = input.bool(true,  "Show ±2 Bands",          group=grp4a)
devUp3  = input.float(2.51, "±3 Above", step=0.01, group=grp4a)
devDn3  = input.float(2.51, "±3 Below", step=0.01, group=grp4a)
showDv3 = input.bool(true,  "Show ±3 Bands",          group=grp4a)
devUp4  = input.float(3.09, "±4 Above", step=0.01, group=grp4a)
devDn4  = input.float(3.09, "±4 Below", step=0.01, group=grp4a)
showDv4 = input.bool(false, "Show ±4 Bands",          group=grp4a)
devUp5  = input.float(4.01, "±5 Above", step=0.01, group=grp4a)
devDn5  = input.float(4.01, "±5 Below", step=0.01, group=grp4a)
showDv5 = input.bool(false, "Show ±5 Bands",          group=grp4a)

// ══════════════════════════════════════════════════════════════
// 1. OPENING PRICE (OP)
// ══════════════════════════════════════════════════════════════

dayOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)

plot(showOP ? dayOpen : na, "OP", color=colOP, linewidth=2)

var label lblOP = na
if showOP and barstate.islast
    label.delete(lblOP)
    lblOP := label.new(bar_index + 2, dayOpen, "OP",
                       xloc=xloc.bar_index, yloc=yloc.price,
                       color=color.new(colOP, 100), textcolor=colOP,
                       style=label.style_label_left, size=size.small)

bgcolor(showOP and close > dayOpen ? color.new(colOPUp,   95)
      : showOP                     ? color.new(colOPDown, 95)
      : na, title="Price vs OP Bias")

// ══════════════════════════════════════════════════════════════
// 2. MLP – Previous Session Midpoint
// ══════════════════════════════════════════════════════════════

prevHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prevLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
mlp      = (prevHigh + prevLow) / 2.0

plot(showMLP ? mlp : na, "MLP", color=colMLP, linewidth=2)

var label lblMLP = na
if showMLP and barstate.islast
    label.delete(lblMLP)
    lblMLP := label.new(bar_index + 2, mlp, "MLP",
                        xloc=xloc.bar_index, yloc=yloc.price,
                        color=color.new(colMLP, 100), textcolor=colMLP,
                        style=label.style_label_left, size=size.small)

// ══════════════════════════════════════════════════════════════
// 3. VOLUME PROFILE  (© kv4coins, MPL 2.0)
// ══════════════════════════════════════════════════════════════

var int          vp_tf_min  = 1000 * timeframe.in_seconds()
var int          vp_lookback = vp_use_visible_range
                             ? math.round((last_bar_time - chart.left_visible_bar_time) / vp_tf_min)
                             : vp_lookback_depth
var line         vp_poc  = na
var line         vp_vah  = na
var line         vp_val  = na
var array<line>  vp_bars = array.new_line()
var array<float> vp_vols = array.new_float(vp_num_bars, 0)

float vp_hi   = ta.highest(vp_lookback)
float vp_lo   = ta.lowest(vp_lookback)
float vp_step = (vp_hi - vp_lo) / (vp_num_bars - 1)

vp_scale(vol, max_vol) =>
    float d = max_vol / vp_lookback / (vp_bar_len_mult / 100)
    int(math.round(vol / d))

vp_calc_va(int max_idx, float max_vol) =>
    float sum_vol = vp_vols.sum()
    float target  = sum_vol * vp_va_percent / 100
    int   va_up   = max_idx
    int   va_dn   = max_idx
    float va_sum  = max_vol
    while va_sum < target
        float v_up = va_up < vp_num_bars - 1 ? vp_vols.get(va_up + 1) : 0.0
        float v_dn = va_dn > 0               ? vp_vols.get(va_dn - 1) : 0.0
        if v_up == 0 and v_dn == 0
            break
        if v_up >= v_dn
            va_sum += v_up
            va_up  += 1
        else
            va_sum += v_dn
            va_dn  -= 1
    [va_dn, va_up]

vp_calculate() =>
    vp_vols.fill(0)
    for i = 0 to vp_lookback - 1
        for j = 0 to vp_num_bars - 1
            float lvl     = vp_lo + vp_step * j
            bool  is_bull = close[i] >= open[i]
            bool  include = vp_volume_type == "Both" ? true
                          : vp_volume_type == "Bullish" ? is_bull : not is_bull
            if lvl >= low[i] and lvl < high[i] and include
                vp_vols.set(j, vp_vols.get(j) + volume[i])

vp_draw() =>
    float max_vol = vp_vols.max()
    int   max_idx = vp_vols.indexof(max_vol)
    int   x2      = bar_index + vp_right_offset
    for i = 0 to vp_num_bars - 1
        int   vol = vp_scale(vp_vols.get(i), max_vol)
        float y   = vp_lo + vp_step * i
        line.set_xy1(vp_bars.get(i), x2 - vol, y)
        line.set_xy2(vp_bars.get(i), x2,        y)
        line.set_color(vp_bars.get(i), max_idx == i ? vp_poc_line_color : vp_bar_color)
    if vp_display_poc
        int   poc_vol = vp_scale(max_vol, max_vol)
        float poc_y   = vp_lo + vp_step * max_idx
        line.set_xy1(vp_poc, bar_index - vp_lookback, poc_y)
        line.set_xy2(vp_poc, x2 - poc_vol - 10,       poc_y)
    if vp_display_va
        [va_dn, va_up] = vp_calc_va(max_idx, max_vol)
        for i = va_dn to va_up
            if i != max_idx
                line.set_color(vp_bars.get(i), vp_va_bar_color)
        if vp_display_va_lines
            int   vah_vol = vp_scale(vp_vols.get(va_up), max_vol)
            int   val_vol = vp_scale(vp_vols.get(va_dn), max_vol)
            int   va_x1   = bar_index - vp_lookback
            float vah_y   = vp_lo + vp_step * va_up
            float val_y   = vp_lo + vp_step * va_dn
            line.set_xy1(vp_vah, va_x1,             vah_y)
            line.set_xy2(vp_vah, x2 - vah_vol - 10, vah_y)
            line.set_xy1(vp_val, va_x1,             val_y)
            line.set_xy2(vp_val, x2 - val_vol - 10, val_y)

if barstate.isfirst
    for i = 0 to vp_num_bars - 1
        vp_bars.push(line.new(bar_index, close, bar_index, close, width=vp_bar_thickness))
    if vp_display_poc
        vp_poc := line.new(bar_index, close, bar_index, close,
                           color=vp_poc_line_color, width=vp_poc_line_thickness)
    if vp_display_va and vp_display_va_lines
        vp_vah := line.new(bar_index, close, bar_index, close,
                           color=vp_va_bar_color, width=vp_va_lines_thickness)
        vp_val := line.new(bar_index, close, bar_index, close,
                           color=vp_va_bar_color, width=vp_va_lines_thickness)

if barstate.islast
    vp_calculate()
    vp_draw()

// ══════════════════════════════════════════════════════════════
// 4. KCX – VWAP + Standard-Deviation Bands
// ══════════════════════════════════════════════════════════════

isNewDay = timeframe.change("D")

var float vw_sum   = 0.0
var float vw_volS  = 0.0
var float vw_v2sum = 0.0

if isNewDay
    vw_sum   := hl2 * volume
    vw_volS  := volume
    vw_v2sum := volume * hl2 * hl2
else
    vw_sum   += hl2 * volume
    vw_volS  += volume
    vw_v2sum += volume * hl2 * hl2

myvwap = vw_volS > 0 ? vw_sum / vw_volS : hl2
dev    = math.sqrt(math.max(vw_v2sum / math.max(vw_volS, 1) - myvwap * myvwap, 0.0))

var float prevwap = na
if isNewDay
    prevwap := nz(myvwap[1])

u1 = myvwap + devUp1 * dev
d1 = myvwap - devDn1 * dev
u2 = myvwap + devUp2 * dev
d2 = myvwap - devDn2 * dev
u3 = myvwap + devUp3 * dev
d3 = myvwap - devDn3 * dev
u4 = myvwap + devUp4 * dev
d4 = myvwap - devDn4 * dev
u5 = myvwap + devUp5 * dev
d5 = myvwap - devDn5 * dev

// Chỉ vẽ VWAP + ±1σ thường trực
pA  = plot(showVWAP ? myvwap : na, "VWAP", color=color.gray, linewidth=2)
pU1 = plot(showVWAP ? u1     : na, "+1σ",  color=color.gray)
pD1 = plot(showVWAP ? d1     : na, "-1σ",  color=color.gray)

plot(showVWAP and showPrevVWAP ? prevwap : na, "Prev VWAP",
     color=close > nz(prevwap) ? color.lime : color.red, style=plot.style_circles)

fill(pA, pU1, color=color.new(color.gray, 90))
fill(pA, pD1, color=color.new(color.gray, 90))

// Bar colors theo vùng hiện tại
barcolor(showBcol and close > myvwap and close < u2  ? color.white  : na, title="BarColor VWAP–+2σ")
barcolor(showBcol and close > d1     and close < myvwap ? color.black : na, title="BarColor -1σ–VWAP")
barcolor(showBcol and close > u1     and close < u2  ? color.gray    : na, title="BarColor +1σ–+2σ")
barcolor(showBcol and close > d2     and close < d1  ? color.gray    : na, title="BarColor -2σ–-1σ")
barcolor(showBcol and close > u2     and close < u3  ? color.maroon  : na, title="BarColor +2σ–+3σ")
barcolor(showBcol and close > d3     and close < d2  ? color.lime    : na, title="BarColor -3σ–-2σ")
barcolor(showBcol and close > u3     and close < u4  ? color.red     : na, title="BarColor +3σ–+4σ")
barcolor(showBcol and close > d4     and close < d3  ? color.lime    : na, title="BarColor -4σ–-3σ")

// Marker khi giá chạm band
vwapSz = vwapLblSize == "Tiny"   ? size.tiny   : vwapLblSize == "Normal" ? size.normal
       : vwapLblSize == "Large"  ? size.large  : vwapLblSize == "Huge"   ? size.huge
       : size.small

// Chỉ vẽ marker sau 1 tiếng kể từ nến ngày mở
// barsSinceReset >= 1: tránh trigger ảo khi band nhảy lúc VWAP reset
var int barsSinceReset = 0
if isNewDay
    barsSinceReset := 0
else
    barsSinceReset += 1

validForMark = barsSinceReset >= 1 and (time - time("D")) >= 3600000

vwap_mark(float band, string lbl, bool isUpper) =>
    col    = isUpper ? color.new(color.red,  30) : color.new(color.lime, 30)
    txtCol = isUpper ? color.red : color.lime
    line.new(bar_index, band, bar_index + 10, band, color=col, width=1)
    label.new(bar_index, band, lbl,
              color=color.new(color.white, 100), textcolor=txtCol,
              style=label.style_label_right, size=vwapSz)

if showVWAP and showDv2 and validForMark
    if high >= u2 and high[1] < u2[1]
        vwap_mark(u2, "+B2", true)
    if low <= d2 and low[1] > d2[1]
        vwap_mark(d2, "-B2", false)

if showVWAP and showDv3 and validForMark
    if high >= u3 and high[1] < u3[1]
        vwap_mark(u3, "+B3", true)
    if low <= d3 and low[1] > d3[1]
        vwap_mark(d3, "-B3", false)

if showVWAP and showDv4 and validForMark
    if high >= u4 and high[1] < u4[1]
        vwap_mark(u4, "+B4", true)
    if low <= d4 and low[1] > d4[1]
        vwap_mark(d4, "-B4", false)

if showVWAP and showDv5 and validForMark
    if high >= u5 and high[1] < u5[1]
        vwap_mark(u5, "+B5", true)
    if low <= d5 and low[1] > d5[1]
        vwap_mark(d5, "-B5", false)
